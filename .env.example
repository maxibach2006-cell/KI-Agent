# Kopieren nach .env und ausfüllen (siehe docs/TENANT_SETUP.md)
CLIENT_ID=00000000-0000-0000-0000-000000000000
TENANT_ID=00000000-0000-0000-0000-000000000000
NOTEBOOK_NAME=MBS 2
TEAM_NAME=Key Account - Kunden

# Optional: andere Modelle
# CHAT_MODEL=qwen2.5:7b
# EMBED_MODEL=bge-m3

# Optional: persönliche Ablage (Ordner je Kunde/Thema), Standard: <Benutzerordner>\KAM-Ablage
# ABLAGE_DIR=C:\Users\name\KAM-Ablage
# ABLAGE_AKTIV=0   # Ablage in der App standardmäßig ausschalten

# Optional: Strom-Tracker (eigenen Tarif eintragen; übriger PC ist eine Schätzung ohne Grafikkarte)
# STROM_PREIS_EURO_KWH=0.35
# STROM_REST_WATT=60
